Calculation:
    expression = Expression '='
;

Expression:
    beginning = Term sum *= SumOperation
;

Term:
    beginning = Factor prod *= MulOperation
;

Factor:
    number = NUMBER | '(' expression = Expression ')'
;

SumOperation:
    operator = SumOperator term = Term
;

MulOperation:
    operator = MulOperator factor = Factor
;

SumOperator:
    '+' | '-'
;

MulOperator:
    '*' | '/'
; 




